{
  "version": "0.1",
  "description": "사기싹제로 위험도 스코어링 규칙. LLM은 이 파일의 signal_id에 맞는 근거(evidence)만 추출하고, 실제 점수 계산은 이 config를 읽는 결정론적 엔진이 수행한다.",

  "score_range": { "min": 0, "max": 100 },

  "risk_levels": [
    { "level": "LOW",      "min": 0,  "max": 20 },
    { "level": "GUARDED",  "min": 21, "max": 40 },
    { "level": "CAUTION",  "min": 41, "max": 60 },
    { "level": "HIGH",     "min": 61, "max": 80 },
    { "level": "CRITICAL", "min": 81, "max": 100 }
  ],

  "confidence_by_source": {
    "official_api": 1.0,
    "platform_listed_info": 0.8,
    "web_search_cited": 0.55,
    "llm_inference_uncited": 0.3
  },

  "_comment_scoring": "raw = sum(base_weight * confidence) over all present signals; hard_gates는 이 계산을 건너뛰고 min_score를 강제한다.",

  "hard_gates": [
    {
      "id": "confirmed_fraud_report_match",
      "label_ko": "피해신고 DB 확정 매칭",
      "description": "판매자의 계좌번호/전화번호/사업자등록번호가 기존 피해신고(더치트 등) DB와 동일 식별자로 확정 매칭됨",
      "required_source": "official_api",
      "min_score": 90
    },
    {
      "id": "business_registration_invalid",
      "label_ko": "사업자등록 무효/말소",
      "description": "국세청 사업자등록정보 진위확인 API 조회 결과 등록번호가 존재하지 않거나 말소 상태",
      "required_source": "official_api",
      "min_score": 90
    }
  ],

  "weighted_signals": [
    {
      "id": "identity_mismatch",
      "category": "identity",
      "label_ko": "판매자 표시명 - 실제 사업자 불일치",
      "base_weight": 30,
      "allowed_sources": ["official_api", "platform_listed_info"],
      "mvp": true
    },
    {
      "id": "registered_address_implausible",
      "category": "identity",
      "label_ko": "등록 사업장 주소가 주거용 건물(빌라/아파트 등)로 추정되거나 사업 규모에 비해 부적절",
      "base_weight": 15,
      "allowed_sources": ["platform_listed_info", "official_api"],
      "mvp": true,
      "note": "MVP는 주소 문자열 패턴(빌라/연립/다세대/아파트+호수 등)으로만 판별. 건축물대장 API 등으로 실제 건물 용도를 확인하면 official_api로 격상 가능"
    },
    {
      "id": "official_brand_relation_unclear",
      "category": "identity",
      "label_ko": "공식 브랜드/법인과의 관계 확인 불가",
